// EVCS ↔ Muscat 플러그인 (EVCS 레포 plugins/muscat).
// 모든 메시지는 FlatBuffers. 키 앞머리는 amr/<robot_id>/evcs/ — 로봇 회사 키(amr/<id>/move/… 등)와 겹치지 않는다.
// 모르는 칸은 무시한다. 시각은 epoch ms (보내는 쪽 시계).
namespace EVCS_PLUGIN;

table Point {
  x: double;
  y: double;
}

// 지금 층에서 배정된 호기의 캐빈 축 — 눈 사실(inside · coming_out …)을 셀 상자를 정한다. 타기 전에도 실린다
table Axis {
  level: string;               // 건물 맵 층 id
  map: string;                 // 그 층 맵 이름
  car_id: string;
  inside_node: string;         // K
  inside: Point;
  front_node: string;          // F
  front: Point;
  door_ratio: double;
  robot_length: double;
  margin: double;
}

// 문 앞 한 걸음 허락 — 호기가 로봇을 태우고 출발층을 떠난 뒤(left_start)에만 Intent 에 실린다. 내린 뒤에는 빠진다.
// 플러그인은 EVCS 와 끊긴 동안에만, 아래가 다 맞을 때 혼자 inside → front 로 곧게 나간다 (돌지 않는다):
//   맵 = goal_map · 위치 good · inlier_ratio ≥ min_inlier_ratio · 몸이 캐빈 안(EVCS 와 같은 자리 규칙) · 문선 ~ front 길이 비었다.
// 확실히 문 밖(EVCS 규칙)이 되면 멈추고 Sense.stepped_out 을 올린다.
table StepOut {
  transfer_id: string;
  goal_level: string;          // 건물 맵 층 id (예: 5F)
  goal_map: string;            // 그 층 맵 이름 (slamnav status map_name)
  car_id: string;              // 건물 맵 호기 id
  inside_node: string;         // K — 캐빈 자리 (그 층 맵 좌표)
  inside: Point;
  front_node: string;          // F — 문 앞
  front: Point;
  door_ratio: double;          // 문선 = F 에서 F→K 길이 × door_ratio
  robot_length: double;        // m — 몸 길이 (F→K 축 방향)
  margin: double;              // m — 문선 앞뒤 여유. 몸 앞끝 ≤ 문선 − margin 이면 확실히 문 밖
  min_inlier_ratio: double;    // 맵 위치가 이만큼 맞아야 한다 (근거 하나가 아니다 — 맵 모양은 층마다 같을 수 있다)
  start_level: string;         // 탄 층 (건물 맵 층 id)
  floors_apart: int;           // 목적층 − 탄 층 (건물 맵 층 차례로, 위가 +) — 수직 이동 · 문 열림 횟수 근거에 쓴다
}
// '내 층' 은 서로 다른 근거 둘 이상이 목적층을 가리킬 때만 확실하다 (하나면 나가지 않는다):
//   승강장 표식(주) · 탄 뒤 수직 이동 적분(IMU · 기압이 있으면) · 출발 뒤 첫 문 열림이고 시간이 층 수와 맞음 · 목적층 승강장 고유 모양.
// 확실하지 않으면 혼자 나가지 않고, 다시 붙은 뒤 EVCS 판단으로 내린다.

// amr/<id>/evcs/intent — EVCS → 플러그인, put. 바뀔 때 곧바로 + 1초마다 통째로. 끝나면 phase done 을 10초 내고 멈춘다.
table Intent {
  stamp_ms: long;
  transfer_id: string;
  phase: string;               // 계약 phase — calling · boarding · riding · alighting · dropoff · done
  step: string;                // 트리 단계 — CALL · GET_ON · SEND_ELEVATOR · RIDE · GET_OFF · GO_TO_GOAL · GO_BACK · HELP
  doing: string;               // 지금 도는 동작 노드 ID (WaitForElevator · BackIntoElevator …)
  wait_sec: uint;              // 그 단계가 알림까지 남은 초 (없으면 0)
  say: string;                 // 이번에 말할 줄 이름 (없으면 "") — sounds/README.md 의 파일 이름
  say_count: uint;             // 말할 때마다 1 늘린다 — 같은 줄을 두 번 말해도 안다
  entry_try: uint;
  entry_max: uint;
  call_try: uint;
  call_max: uint;
  goal_level: string;          // 도착층 (건물 맵 층 id)
  car_level: string;           // 그 호기의 지금 층 (모르면 "")
  stuck: bool;                 // 계약 status 와 같은 값
  reason: string;
  outcome: string;             // done 일 때
  step_out: StepOut;           // 문 앞 한 걸음 허락 (없으면 허락 없음)
  axis: Axis;                  // 지금 층 · 배정된 호기의 캐빈 축 (모르면 없다)
  step_age_sec: uint;          // 지금 단계에 들어온 뒤 지난 초 (보류 시간 빼고)
  next: string;                // 다음 동작 코드 (없으면 "")
}

// amr/<id>/evcs/sense — 플러그인 → EVCS, put. 10 Hz + 바뀔 때 곧바로. 1초 넘게 없으면 EVCS 는 없는 셈 친다.
table Sense {
  stamp_ms: long;
  transfer_id: string;         // 플러그인이 받은 마지막 intent 의 transfer_id
  shadow: bool;                // 섀도 — 눈(inside … pushed)은 EVCS 가 기록만 하고 트리에 쓰지 않는다
  inside: int;                 // 캐빈 안 사람 · 물건 묶음 수 (-1 = 모른다)
  coming_out: bool;
  spot_free: bool;
  door_busy: bool;
  front_busy: bool;
  moved_aside: bool;
  pushed: bool;
  stepped_out: bool;           // 끊긴 동안 StepOut 허락으로 혼자 문 밖에 나왔다 (섀도와 상관없이 EVCS 가 쓴다)
  stepped_out_level: string;   // 나온 층 (건물 맵 층 id)
  stepped_out_ms: long;        // 문 밖에 선 때
  bumper_locked: bool;         // 안전 보드가 범퍼 정지를 잠가 두었다 (status sf_bumper_detect 그대로)
  stepping_out: bool;          // 지금 혼자 문 밖으로 나가는 중 — EVCS 는 이 이동을 '다른 쪽이 로봇을 몬다' 로 보지 않는다
  bumper_hit_ms: long;         // 이 transfer 에서 범퍼가 마지막으로 눌린 때 (0 = 없음) — 끊긴 동안 눌렸다 풀려도 EVCS 가 안다
}

// amr/<id>/evcs/ask — 플러그인 → EVCS, put. 화면 버튼. 같은 id 는 한 번만 (끊긴 동안 쌓았다 다시 붙으면 보낸다, 60초 지난 건 버린다).
table Ask {
  stamp_ms: long;
  transfer_id: string;
  ask: string;                 // robot_first(U5 먼저 타세요) · person_first(U6 제가 먼저) · next_car(U7 다음 거 타 주세요)
  id: string;
}

// ── amr/<id>/evcs/plan — EVCS → 플러그인, put. 바뀔 때 곧바로 + 1초마다. transfer 없으면 보내지 않는다.
// 살아 있는 BT 를 읽어 만든다 — 하드코딩 표 없이 트리 모양이 바뀌면 따라간다.

table PlanStep {
  name: string;                // 단계 이름 (CALL · GET_ON …)
  label: string;               // 사람이 읽을 이름 (부르기 · 타기 …, 없으면 name)
  alert_sec: uint;             // 알림 한도 (초, 0 = 없음)
  state: string;               // done · now · todo
  since_ms: long;              // now 일 때 — 이 단계에 들어온 때 (epoch ms)
  is_branch: bool;             // Fallback 의 대안으로만 도는 Step (레일에서 뺀다)
}

table PlanTimer {               // 노드가 알린 시계 (0.1.13 — 예전 *_sec 포트 짐작 대신)
  port: string;                // 시계 이름
  port_text: string;           // 넘으면: fail · alert · ok · guard
  value_sec: double;           // 한도
  elapsed_sec: double;         // 지난 초 (세지 않으면 0)
}

// XML 에 적은 포트 아닌 속성 — 사람 문장(say_now · ask · say_over …)은 트리 파일에 적는다. EVCS 는 키를 모른다
table PlanAttr {
  key: string;
  value: string;
}

// 노드가 스스로 알린 시계 — 실행 중 노드와 그 위(Step 포함) · 감시 조건
table PlanClock {
  node_id: string;
  node_name: string;
  name: string;                // 시계 이름 (노드가 정한다)
  limit_sec: double;
  elapsed_sec: double;
  counting: bool;              // 지금 세는 중
  on_over: string;             // 넘으면: fail(그 노드 실패) · alert(알리고 계속) · ok(그 노드 끝) · guard(감시 걸림)
  still: bool;                 // 못 나아간 시간 (나아가면 0)
  attrs: [PlanAttr];           // 시계를 가진 노드에서 Step 까지 모은 속성 (say_over …)
  after_id: string;            // 넘으면 가는 곳
  after_name: string;
  after_attrs: [PlanAttr];
}

table PlanNode {
  id: string;                  // 트리 안 고유 경로 (fullPath)
  parent: string;              // 부모 id
  depth: uint;
  kind: string;                // sequence · reactive_sequence · fallback · retry · inverter · force_success · force_failure · subtree · action · condition · decorator
  type: string;                // registrationName
  name: string;                // XML name 속성 (없으면 type)
  text: string;                // manifest description
  status: string;              // idle · running · success · failure · skipped
  since_ms: long;              // 그 상태가 된 때 (epoch ms, 0 = 모름)
  tries: uint;                 // RetryUntilSuccessful 이면 시도한 수
  max_tries: uint;             // RetryUntilSuccessful 이면 한도
  timers: [PlanTimer];         // 이 노드의 *_sec 포트와 시계
  inverted: bool;              // Inverter 아래면 true (아님)
  unnamed_control: bool;       // 이름 없는 제어/데코레이터 (접기 대상)
  attrs: [PlanAttr];           // 이 노드의 XML 속성 (포트 아닌 것)
}

table PlanGuard {
  node_id: string;             // 감시 조건 노드 id
  name: string;
  text: string;
  status: string;              // success · failure
  reactive_id: string;         // ReactiveSequence id
  inverted: bool;              // Inverter 아래면 true (… 아님)
}

table PlanNext {
  when: string;                // ok · fail · timeout · guard
  after_sec: double;           // 시계가 있으면 남은 초 (없으면 0)
  node_id: string;             // 가는 노드 id
  name: string;                // 가는 노드 이름 (XML name 또는 type)
  text: string;                // 가는 노드 설명
  attrs: [PlanAttr];           // 가는 곳의 사람 문장 (Step 이면 안쪽 첫 잎부터 Step 까지)
}

table Plan {
  stamp_ms: long;
  transfer_id: string;
  steps: [PlanStep];
  nodes: [PlanNode];           // 지금 단계 서브트리를 평평하게
  guards: [PlanGuard];
  next: [PlanNext];            // 예측
  clocks: [PlanClock];         // 노드가 알린 시계
  face: [PlanAttr];            // 실행 중 잎에서 Step 까지 모은 속성 (가까운 것이 먼저) — 얼굴 '지금'
  stalled: bool;               // 실행 중 잎이 막혀 있다 (막힘 시계 1.5초 넘게) — 얼굴 '부탁'
}

root_type Intent;
