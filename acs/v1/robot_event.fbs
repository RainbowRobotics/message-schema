include "acs_robots.fbs";

namespace ACS;

/*
    로봇 이벤트 (v1, 2026-11-26)

    흐름    : 정책(State)과 Task Step(SDK state.publish_event)이 로봇 이벤트를 State에 알리면 State가 저장한 뒤
              토픽 하나로 발행한다. 받는 곳(External SMC 등)은 구독해서 이름·mode로 골라 쓴다. 보내는 쪽은 받는 쪽을 모른다.
              예전 Step 보고(TaskReport, 로봇별 pubReport 토픽)와 정책 이벤트 변경(acs/state/policy/robotEventChanged)을 대신한다.
    mode    : once  = 한 번 일어난 일(작업 단계 stage.arrival 등)
              on    = 상태를 켬(battery.low 등). State가 로봇 active_events에 둔다
              off   = 상태를 끔
    유실    : State가 30일 보관한다. 받는 쪽은 시작·주기마다 acs/state/event/listEvents로 다시 읽어 빠진 것을 채운다.
              event_id로 한 번만 반영하므로 같은 이벤트가 두 길로 와도 된다.
    key     : pub acs/state/event   RobotEvent   (로봇·실행 구분은 토픽이 아니라 아래 칸으로 한다)
*/

/*
    category    : Pub / Sub
    topic       : acs/state/event
    usage       : 로봇 이벤트 한 건
    field
        - event_id    : 이벤트 ID. Step은 "실행ID:StepID:순번", 정책은 "policy:정책ID:로봇ID:시각" (필수)
        - name        : 이벤트 이름. 점으로 나눈 영문 소문자 (예: stage.arrival, battery.low) (필수)
        - mode        : once · on · off (필수)
        - robot_id    : 대상 로봇 ID (필수)
        - process_id  : Step이 보냈을 때 Task 실행 ID
        - step_id     : Step이 보냈을 때 Step ID
        - policy_id   : 정책이 보냈을 때 정책 ID
        - source      : step · policy
        - occurred_at : 일어난 시각 (ISO 8601 UTC)
        - params      : 부가 값 목록 (Param: key·value·type). 키의 뜻은 받는 쪽이 정한다 (예: task_id, location_id)
*/
table RobotEvent {
    event_id: string;
    name: string;
    mode: string;
    robot_id: string;
    process_id: string;
    step_id: string;
    policy_id: string;
    source: string;
    occurred_at: string;
    params: [Param];
}
