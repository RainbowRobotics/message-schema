// rhci -> rhc, 20 Hz, key <prefix>/cmd/move. rhc keeps its 0.5 s expiry rule.
namespace RHC;

table CmdMove {
  version:ushort = 1;
  t_ns:ulong;            // rhci CLOCK_MONOTONIC at publish
  seq:ubyte;             // MOBILE move_seq (wraps)
  vx:float;
  vy:float;
  wz:float;
  hpp_side:ubyte;        // QD only: 1 = normal, 2 = SIDE; 0 = n/a
}

root_type CmdMove;
