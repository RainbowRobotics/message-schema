// rhc local (not in the app_slamnav2 rhci contract): bus and motor load for the rhc_ui Load tab.
//   out:  <prefix>/diag, 1 Hz
namespace RHC;

table CanPort {
  name:string;           // interface, e.g. can_drive
  role:string;           // drives / system (BMS, lift)
  bitrate:uint;          // [bit/s] from config
  load_pct:float;        // last second, frame bits without stuffing (lower bound, stuffing adds up to ~20 %)
  rx_fps:float;          // frames from the other nodes
  tx_fps:float;          // frames rhc sent
  tx_fail:uint;          // last second
  err_frames:uint;       // controller error frames, last second
}

table AxisLoad {
  node:ubyte;
  role:string;           // front drive / rear drive / front steer / rear steer
  torque_pct:float;      // 6077 [% rated torque]
  current_pct:float;     // 6078 [% rated current]
  current_a:float;       // current_pct x rated current from config, < 0 when the rating is not configured
}

table Diag {
  version:ushort = 1;
  t_ns:ulong;
  seq:uint;
  ports:[CanPort];
  axes:[AxisLoad];
  led_on:bool;           // LED.TYPE can
  led_command:ubyte;     // last slamnav2 / tool code
  led_output:ubyte;      // sent: command, or 1 (red) on a safety stop, 6 (yellow) with no host
}

root_type Diag;
