include "func_return.fbs";
include "common_struct.fbs";

namespace IPC;
//--------------------------------------------------------------
//"get_core_data"
table Request_Get_Core_Data {
    option      : int;
    name        : string;
}
table Response_Get_Core_Data {
    valid       : int;
    type        : int;//0=number, 1=array, 2=string,
    payload_num : float;
    payload_arr : [float];
    payload_str : string;
}

//"get_core_data_multi"
table Request_Get_Core_Data_Multi {
    items:  [Request_Get_Core_Data];
}
table Response_Get_Core_Data_Multi {
    names:  [string];
    items:  [Response_Get_Core_Data];
}
//--------------------------------------------------------------
table Val_Number     { v: float; }
table Val_String     { v: string; }
table Val_Number_Arr { v: [float]; }
table Val_String_Arr { v: [string]; }
union Func_Value {
    Val_Number, Val_String, Val_Number_Arr, Val_String_Arr,
}
// union 을 바로 vector 에 담으면 Python flatc 가 지원하지 않아서 테이블로 한 번 감쌈
table Func_Arg {
    arg_name:  string; // 비우면 위치 인자, 채우면 키워드 인자
    arg_value: Func_Value;
}


table Func_Call {
    func: string (required);
    args: [Func_Arg];
}

table Func_Return {
    execution_result: int;     // 0 = OK, -1 = 모르는 함수, -2 = 인자 개수/타입 불일치, -3 = 함수 안에서 예외
    execution_error_msg:        string;
    function_return:       Func_Value;
}

// "get_core_function"
table Request_Get_Core_Function {
    items: [Func_Call];
}

table Response_Get_Core_Function {
    items: [Func_Return];
}
//--------------------------------------------------------------
table Request_Get_Relative_Value {
    relative_value :    MoveInput_Target;
    reference_value:    MoveInput_Target;
    move_type:          int;
}

table Response_Get_Relative_Value {
    calculated_result:  int;
    calculated_value:   MoveInput_Target;
}
//--------------------------------------------------------------
table Request_Get_Absolute_Value {
    reference_value:    MoveInput_Target;
    move_type:          int;
}

table Response_Get_Absolute_Value {
    calculated_result:  int;
    calculated_value:   MoveInput_Target;
}
//--------------------------------------------------------------
// SDK 내부 집계 결과 (RBManipulateProgramSDK::set_pin_point_or_joint 반환).
// 대응하는 wire 메시지는 없다 — Relative/Absolute 계산 결과를 공통 타입으로
// 되돌려주기 위한 struct 정의용. 필드는 Response_Get_{Relative,Absolute}_Value 와 동일.
table Response_Get_Value {
    calculated_result:  int;
    calculated_value:   MoveInput_Target;
}
//--------------------------------------------------------------
table Request_Get_Tcp_Value {
    option: int;
}

table Response_Get_Tcp_Value {
    carte_info: [float];
}

table Request_Get_Joint_Value {
    option: int;
}

table Response_Get_Joint_Value {
    joint_info: [float];
}
//--------------------------------------------------------------
// "get_digital_input"
table Request_Get_Digital_Input {
}
table Response_Get_Digital_Input {
    digital_input: [byte];
}
//--------------------------------------------------------------
// "get_digital_output"
table Request_Get_Digital_Output {
}
table Response_Get_Digital_Output {
    digital_output: [byte];
}
//--------------------------------------------------------------
