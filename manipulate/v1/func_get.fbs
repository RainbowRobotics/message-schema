include "func_return.fbs";
include "common_struct.fbs";

namespace IPC;
//--------------------------------------------------------------
table Request_Get_Core_Data {
    option      : int;
    name        : string;
}

table Response_Get_Core_Data {
    valid       : int;
    type        : int;//0=number, 1=array, 2=string,
    payload_num : float;
    payload_arr : [float];
    payload_str : string;
}
//--------------------------------------------------------------
table Request_Get_Relative_Value {
    relative_value :    MoveInput_Target;
    reference_value:    MoveInput_Target;
    move_type:          int;
}

table Response_Get_Relative_Value {
    calculated_result:  int;
    calculated_value:   MoveInput_Target;
}
//--------------------------------------------------------------
table Request_Get_Absolute_Value {
    reference_value:    MoveInput_Target;
    move_type:          int;
}

table Response_Get_Absolute_Value {
    calculated_result:  int;
    calculated_value:   MoveInput_Target;
}
//--------------------------------------------------------------
// SDK 내부 집계 결과 (RBManipulateProgramSDK::set_pin_point_or_joint 반환).
// 대응하는 wire 메시지는 없다 — Relative/Absolute 계산 결과를 공통 타입으로
// 되돌려주기 위한 struct 정의용. 필드는 Response_Get_{Relative,Absolute}_Value 와 동일.
table Response_Get_Value {
    calculated_result:  int;
    calculated_value:   MoveInput_Target;
}
//--------------------------------------------------------------
table Request_Get_Tcp_Value {
    option: int;
}

table Response_Get_Tcp_Value {
    carte_info: [float];
}

table Request_Get_Joint_Value {
    option: int;
}

table Response_Get_Joint_Value {
    joint_info: [float];
}
//--------------------------------------------------------------
// "get_digital_input"
table Request_Get_Digital_Input {
}
table Response_Get_Digital_Input {
    digital_input: [byte];
}
//--------------------------------------------------------------
// "get_digital_output"
table Request_Get_Digital_Output {
}
table Response_Get_Digital_Output {
    digital_output: [byte];
}
//--------------------------------------------------------------
