include "func_return.fbs";
include "common_struct.fbs";

namespace IPC;

// "call_reboot_pc"
table Request_Call_Reboot_PC{
  password: int;
}

// "save_robot_code"
table Request_Save_Robot_Code {
  code: int;
  option: int;
}

// "call_send_can"
table Request_Send_CAN_Msg {
  channel: int;
    // Channel [드랍다운 2개]
      // Ch 0
      // Ch 1
  id: int;
    // CAN ID [입력창]
  dlc: int;
    // DLC [드랍다운 9개]
      // 0 = DLC 0
      // 1 = DLC 1
      // ..
      // 8 = DLC 8
  d0: int;
  d1: int;
  d2: int;
  d3: int;
  d4: int;
  d5: int;
  d6: int;
  d7: int;
    // D0 ~ D7 [입력란 8개 .. 숫자3개 들어갈 폭이면 됨]
}

// "call_persist_joint_erase"
table Request_Erase_PersistJoint {
  target_angle: [float];
}

// "save_area_parameter"
table Request_Save_Area_Para {
    area_no: int;

    area_name: string;
    area_type: int;
        // 0 : Nothing
        // 1 : Sphere
        // 2 : Capsule
        // 3 : Box
    area_x: float;
    area_y: float;
    area_z: float;
    area_rx: float;
    area_ry: float;
    area_rz: float;

    area_para_0: float;
    area_para_1: float;
    area_para_2: float;

    area_purpose: int;
      // Area Purpose
        // 0 : N/A
        // 1 : Self collision detection
        // 2 : PFL Check Area
}

// "save_user_frame_parameter"
table Request_Save_User_Frame {
    userf_no: int;

    userf_name: string;
    userf_x: float;
    userf_y: float;
    userf_z: float;
    userf_rx: float;
    userf_ry: float;
    userf_rz: float;
}

// "save_after_action"
table Request_Save_After_Action {
  after_no:       int;//0~15
  after_option:   int;
    // 0 : Do nothing
    // 1 : Run User Script 0
    // 2 : Run User Script 1
    // ..
    // 16 : Run User Script 15
}

// "save_network_parameter"
table Request_Save_Network {
  static_vs_dhcp:   int;
    // Setting Mode (드랍다운)
      // 0 : Static 
      // 1 : DHCP 
  addr_0: int;//IP 0 .. 3
  addr_1: int;
  addr_2: int;
  addr_3: int;

  mask_0: int;//Mask 0 .. 3
  mask_1: int;
  mask_2: int;
  mask_3: int;

  gate_0: int;//Gateway 0 .. 3
  gate_1: int;
  gate_2: int;
  gate_3: int;
}



// "save_user_script"
table Request_Save_User_Script {
  script_no: int;
  script_txt: string;
}

// "save_side_din_function"
table Request_Save_SideDin_SpecialFunc {
  port_num:         int;
  desired_function: int;
}

// "save_side_dout_function"
table Request_Save_SideDout_SpecialFunc {
  port_num:         int;
  desired_function: int;
}

// "save_side_din_filter"
table Request_Save_SideDin_FilterCount {
  port_num: int;
  desired_count: int;
}

table Request_Save_ExtDin_SpecialFunc {
  port_num:         int;
  desired_function: int;
}

table Request_Save_ExtDout_SpecialFunc {
  port_num:         int;
  desired_function: int;
}

table Request_Save_ExtDin_FilterCount {
  port_num: int;
  desired_count: int;
}

table Request_SideDout_General {
  port_num: int;
  desired_out: int;
}

table Request_SideAout_General {
  port_num: int;
  desired_voltage: float;
}

table Request_SideDout_Toggle {
  port_num: int;
}

table Request_SideDout_Bitcombination {
  port_start      : int;
  port_end        : int;
  desired_value   : int;
  direction_option : int;
}

table Request_SideDout_Pulse {
  port_num : int;
  block_mode : int;
  direction : int;
  time_1 : float;
  time_2 : float;
  time_3 : float;
}

table Request_ExtDout_General {
  port_num: int;
  desired_out: int;
}

table Request_ExtAout_General {
  port_num: int;
  desired_voltage: float;
}

table Request_ExtDout_Toggle {
  port_num: int;
}

table Request_ExtDout_Bitcombination {
  port_start      : int;
  port_end        : int;
  desired_value   : int;
  direction_option : int;
}

table Request_ExtDout_Pulse {
  port_num : int;
  block_mode : int;
  direction : int;
  time_1 : float;
  time_2 : float;
  time_3 : float;
}
