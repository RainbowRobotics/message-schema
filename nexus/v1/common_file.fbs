namespace IPC;

// "{robot_model}/call_save_file" — RBBaseSDK.save_file
// 파일을 1MiB 청크로 나눠 offset 순서대로 하나씩 보낸다 (청크마다 query 1회, 응답 받고 다음 청크).
// CoreSW 는 offset 위치에 data 를 쓰고 청크마다 Response_Save_File 로 답한다.
//   offset == 0 : 파일 새로 만들기(기존 내용 덮어씀)
//   is_last == true: 마지막 청크 → 파일 닫기/완료 (빈 파일은 data 없이 offset 0, is_last true 한 번)
// ok == false 를 받으면 SDK 는 남은 청크를 보내지 않는다. 전체 크기는 SDK 가 1GB 로 제한.
table Request_Save_File {
  path: string;       // 저장 디렉터리. CoreSW 저장 루트 기준 상대경로 (예: "hello/dir", 루트는 CoreSW 가 결정, 빈 값 = 루트). 앞뒤 '/' 없음, '..'·'.'·빈 구간 없음 (SDK 가 보장)
  file_name: string;  // 저장할 파일 이름 그대로 (예: "a.tar.gz"). '/'·'\'·NUL 없음, '.'·'..' 아님 (SDK 가 보장)
  mime_type: string;  // 업로드 시 MIME 타입 (예: "text/plain"). 모르면 빈 값
  offset: ulong;      // 이 청크의 파일 내 시작 위치 (바이트)
  total_size: ulong;  // 전체 파일 크기 (바이트)
  data: [ubyte];      // 청크 데이터
  is_last: bool;      // 마지막 청크 여부
}

table Response_Save_File {
  ok: bool;
    // true : 성공, false : 실패
  message: string;
    // 실패 이유 (성공 시 비워도 됨)
}
