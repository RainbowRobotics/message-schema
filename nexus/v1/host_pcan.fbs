namespace IPC;

// =========================================================================
//                            Data Structures
// =========================================================================
table CANMessage {
    arbitration_id:uint;
    data:[ubyte];
    dlc:ubyte;

    is_extended_id:bool = false;
    is_remote_frame:bool = false;

    is_fd:bool = false;
    bitrate_switch:bool = false;

    is_error_frame:bool = false;
    error_state_indicator:bool = false;
    channel:string;
    timestamp:double;
}
enum CANState:ubyte {
    DISCONNECTED = 0,
    ACTIVE = 1,
    WARNING = 2,
    PASSIVE = 3,
    BUS_OFF = 4,
    ERROR = 5
}
table CANStatus {
    connected:bool;
    state:CANState;
    interface:string;
    channel:string;
    bitrate:uint;
    fd:bool;
    data_bitrate:uint = 0;
    rx_count:ulong;
    tx_count:ulong;
    last_error:string;
}

// =========================================================================
//                                  Query
// =========================================================================

/*
    topic : muscat/can/connect
    params :
        - client_id : 연결을 요청한 클라이언트 식별자 (필수, 재시작해도 바뀌지 않는 값. 예: 플러그인 ID)
        - channel : 채널식별자
        - interface : 인터페이스 식별자
        - bitrate : 전송 속도
        - fd : CAN FD 여부
        - data_bitrate : 데이터 전송 속도
        - receive_own_messages : 자기 수신 메시지 수신 여부
        - success : 성공 여부
        - message : 실패 시 메시지
    설명 :
        - 같은 채널을 여러 클라이언트가 함께 연결할 수 있다. Host는 채널마다 client_id 목록을 유지한다.
        - 이미 열린 채널이면 client_id만 목록에 추가한다. 같은 client_id로 다시 요청해도 하나로 취급한다.
        - socketcan은 인터페이스에 설정된 bitrate와 요청 bitrate가 다르면 거절한다. Host는 bitrate를 바꾸지 않는다.
        - client_id가 비어 있으면 거절한다.
*/
table RequestCANConnect {
    interface:string;
    channel:string;
    bitrate:uint = 1000000;
    fd:bool = false;
    data_bitrate:uint;
    receive_own_messages:bool = false;
    // 기존 필드 뒤에 추가: 앞에 넣으면 이전 클라이언트의 interface 값이 client_id로 읽힌다.
    client_id:string;
}
table ResponseCANConnect {
    success:bool;
    channel:string;
    message:string;
}

/*
    topic : muscat/can/disconnect
    params :
        - client_id : 연결 시 사용한 클라이언트 식별자 (필수)
        - channel : 채널식별자 (필수)
        - success : 성공 여부
        - message : 실패 시 메시지
    설명 :
        - 채널의 client_id 목록에서 이 클라이언트만 제거한다. 목록이 비면 채널을 닫는다.
        - 목록에 없는 client_id로 요청하면 채널을 그대로 두고 성공으로 응답한다.
*/
table RequestCANDisconnect {
    channel:string;
    client_id:string;
}
table ResponseCANDisconnect {
    success:bool;
    channel:string;
    message:string;
}


/*
    topic : muscat/can/status
    params :
        - channel : 채널식별자
        - success : 성공 여부
        - message : 실패 시 메시지
*/
table RequestCANStatus {
    channel: string;
}
table ResponseCANStatus {
    status: CANStatus;
}

/*
    topic : muscat/can/statusAll
    params :
        - channel : 채널식별자
        - success : 성공 여부
        - message : 실패 시 메시지
*/
table RequestCANStatusAll {
}
table ResponseCANStatusAll {
    status:[CANStatus];
}

/*
    topic : muscat/can/transmit
    params :
        - channel : 채널 식별자
        - message
            - arbitration_id : CAN ID. Standard면 11bit, Extended면 29bit
            - data  : CAN Payload. Classical CAN 최대 8byte, CAN FD 최대 64byte
            - dlc : Data Length Code. Classical CAN 0~8, CAN FD 0~15
            - is_extended_id : 29bit Extended CAN ID 여부
            - is_remote_frame : RTR(Remote Transmission Request) 여부
            - is_fd : CAN FD 프레임 여부
            - bitrate_switch : CAN FD의 BRS(Bit Rate Switch) 여부
        - success : 성공 여부
        - tx_count : 전송 카운트
        - message : 실패 시 메시지
*/
table RequestCANTransmit {
    channel: string;
    message: CANMessage;
}
table ResponseCANTransmit {
    success: bool;
    tx_count: ulong;
    message: string;
}


// =========================================================================
//                                  Publish
// =========================================================================

/*
    topic : muscat/can/receive
    params :
        - message
            - arbitration_id : CAN ID. Standard면 11bit, Extended면 29bit
            - data  : CAN Payload. Classical CAN 최대 8bit, CAN FD 최대 64bit
            - dlc : Data Length Code. 0-8bit
            - is_extended_id : 29bit Extended CAN ID 여부
            - is_remote_frame : RTR(Remote Transmission Request) 여부
            - is_error_frame : Error Frame 여부
            - is_fd : CAN FD 프레임 여부
            - bitrate_switch : CAN FD의 BRS(Bit Rate Switch) 여부
            - channel : 채널식별자
            - timestamp : 수신시간
            - error_state_indicator : 에러 상태 표시기
        - rx_count : 수신 카운트
*/
table ResponseCANReceive {
    message:CANMessage;
    rx_count:ulong;
}

/*
    [ PCAN 수신 프레임 묶음 ]
    - 토픽 : muscat/can/receive-batch
    - 설명 : 수신 프레임을 짧은 주기(10 ms)로 모아 한 번에 발행. 프레임마다 발행하는 muscat/can/receive와
             같은 프레임을 수신 순서대로 담으며, 구독 측 메시지 처리 횟수를 줄이기 위해 사용
    - 응답 :
        - messages : 수신 순서대로의 CAN 프레임 목록 (각 항목은 ResponseCANReceive.message와 동일)
        - rx_count : 묶음 마지막 프레임 기준 수신 카운트
*/
table ResponseCANReceiveBatch {
    messages:[CANMessage];
    rx_count:ulong;
}
