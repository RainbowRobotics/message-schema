    id: string;
    crossing: bool;
    result: string;
    message: string;
}

// -------------------------------------------------
// -----------                              --------
// -----------     Pub / Sub  (Result )     --------
// -----------                              --------
// -------------------------------------------------

/*
    category    :       Pub / Sub (Result)
    topic       :       {robotType}/control/resultDock
    usage       :       도킹 제어 결과 응답
    field
        - command       :       control Callback 명령 (string)
            - "dock"  "undock"  "dockStop"
        - method        :       "charge" | "object" (빈 값 = charge, 구버전 호환)
        - object_type   :       method "object" 의 대상 종류 ("shape")
        - switch        :       true(on) / false(off)
        - result        :       이동 결과
            - success       :       동작 성공.
            - fail          :       동작 실패.
            - start         :       동작 시작.
            - cancel        :       동작 중, 새로운 명령에 의해 기존 동작 취소.
        - 대상 도킹 전용 (세션 종료 시 1회, move/goal 자동 시작 세션은 id "")
            - reason        :       fail·cancel 사유 "CODE:detail" (예: NO_DETECTION:DETECT 시간 초과, CANCELLED:halt)
            - err_x         :       최종 추정 오차, 접근축 [m] (음수 = 덜 들어감)
            - err_y         :       최종 추정 오차, 횡 [m]
            - err_yaw_deg   :       최종 추정 오차, 각도 [deg]
*/
table ResultControlDock {
    id: string;
    command: string;
    result: string;
    message: string;
    station_learned: bool = false;
    method: string;
    object_type: string;
    reason: string;
    err_x: double;
    err_y: double;
    err_yaw_deg: double;
}


