namespace SLAMNAV;


// -------------------------------------------------
// -----------                              --------
// -----------       Data Structure         --------
// -----------                              --------
// -------------------------------------------------


/*
    category    :       Data Structure
    usage       :       safety Flag Structure
    field
        - name          :       emo, obstacle, bumper, interlock, operationStop,
                                measMismatch, overSpeed, fieldMismatch
        - value         :       true / false
*/
table SafetyFlag {
    name: string;
    value: bool;
}
/*
    category    :       Data Structure
    usage       :       Obstacle Range Structure
*/
struct ObsBox {
    x: float;
    y: float;
    z: float;
}

// -------------------------------------------------
// -----------                              --------
// -----------          RPC(Query)          --------
// -----------                              --------
// -------------------------------------------------

/*
    category    :       RPC
    response    :       One-shot
    topic       :       {robotType}/control/getSafetyField
    usage       :
    field
        - safety_field  :       safety field number
*/
table RequestGetSafetyField {
    id: string;
}
table ResponseGetSafetyField {
    id: string;
    safety_field: uint8;
    result: string;
    message: string;
}


/*
    category    :       RPC
    response    :       Delayed One-shot
    topic       :       {robotType}/control/setSafetyField
    usage       :
    field
        - safety_field  :       safety field number
*/
table RequestSetSafetyField {
    id: string;
    safety_field: uint8;
}
table ResponseSetSafetyField {
    id: string;
    safety_field: uint8;
    result: string;
    message: string;
}


/*
    category    :       RPC
    response    :       One-shot
    topic       :       {robotType}/control/getSafetyFlag
    usage       :
    field
        - safety_flag  :        safety Flag Structure
*/
table RequestGetSafetyFlag {
    id: string;
}
table ResponseGetSafetyFlag {
    id: string;
    safety_flag: [SafetyFlag];
    result: string;
    message: string;
}


/*
    category    :       RPC
    response    :       Delayed One-shot
    topic       :       {robotType}/control/setSafetyFlag
    usage       :
    field
        - safety_flag  :        safety Flag Structure
*/
table RequestSetSafetyFlag {
    id: string;
    safety_flag: [SafetyFlag];
}
table ResponseSetSafetyFlag {
    id: string;
    safety_flag: [SafetyFlag];
    result: string;
    message: string;
}


/*
    category    :       RPC
    response    :       One-shot
    topic       :       {robotType}/control/getSafetyIo
    usage       :
    field
        - mcu0_din      :       MCU0 Digital Input (8bit)
        - mcu1_din      :       MCU1 Digital Input (8bit)
        - mcu0_do       :       MCU0 Digital Output (8bit)
        - mcu1_do       :       MCU1 Digital Output (8bit)
*/
table RequestGetSafetyIo {
    id: string;
}
table ResponseGetSafetyIo {
    id: string;
    mcu0_din: [bool];
    mcu1_din: [bool];
    mcu0_dio: [bool];
    mcu1_dio: [bool];
    result: string;
    message: string;
}


/*
    category    :       RPC
    response    :       Delayed One-shot
    topic       :       {robotType}/control/setSafetyIo
    usage       :
    field
        - mcu0_din      :       MCU0 Digital Input (8bit)
        - mcu1_din      :       MCU1 Digital Input (8bit)
*/
table RequestSetSafetyIo {
    id: string;
    mcu0_din: [bool];
    mcu1_din: [bool];
}
table ResponseSetSafetyIo {
    id: string;
    mcu0_din: [bool];
    mcu1_din: [bool];
    mcu0_dio: [bool];
    mcu1_dio: [bool];
    result: string;
    message: string;
}


/*
    /sensor/setSafetyLidar로 옮겨짐!~!!!!! YUJIN
    category    :       RPC
    response    :       One-shot
    topic       :       {robotType}/control/setDetectMode
    usage       :       safety LiDAR obstacle detection ON/OFF
                        (현재 상태는 Status.robot_state.detect_mode 펍 참조)
    field
        - switch        :       true(on) / false(off)
*/
table RequestSetDetectMode {
    id: string;
    switch: bool;
}
table ResponseSetDetectMode {
    id: string;
    switch: bool;
    result: string;
    message: string;
}


/*
    category    :       RPC
    response    :       Callback
    topic       :       {robotType}/control/dock
    usage       :       도킹 시작
    field
        - method        :       도킹 방식. "" 또는 "charge" = 충전 도킹(기존), "object" = 대상 도킹 (object_type 으로 종류 지정)
        - object_type   :       method "object" 의 대상 종류. "shape" = 형상 도킹(라이다로 대상 형상 검출, 비접촉 정지)
        - node_id       :       대상 도킹 출발 노드 id (형상: features 에 SHAPE_MARKER). "" = 현재 위치의 노드 자동 선택.
                                출발 노드 근처(±0.3 m, 30°)에서 호출. "charge" 는 무시
        - result        :       accept | reject
        - message       :       reject 사유 코드 (예: UNKNOWN_METHOD, UNKNOWN_OBJECT_TYPE, NO_SHAPE_NODE_HERE, NOT_AT_START,
                                LOC_NOT_GOOD, DRIVE_ACTIVE)
    note        :       형상 도킹 운영 경로는 move/goal — SHAPE_MARKER 노드에 도착하면 자동 시작 (slamnav_move.fbs).
                        결과는 resultDock (method "object", object_type "shape")
*/
table RequestDock {
    id: string;
    method: string;
    object_type: string;
    node_id: string;
}
table ResponseDock {
    id: string;
    result: string;
    message: string;
}


/*
    category    :       RPC
    response    :       Callback
    topic       :       {robotType}/control/undock
    usage       :       도킹 해제
    field
        - method        :       "" = 현재 정박 상태로 자동 판단 (대상 도킹 정박·대상 앞이면 object, 아니면 charge),
                                "charge" | "object" = 명시
        - object_type   :       method "object" 의 대상 종류. "" = 정박 중인 대상, "shape" = 형상 도킹 해제
                                (진입 반대 방향 후퇴, 거리 config SHAPE_DOCK_UNDOCK_OFFSET, 음수 = 로봇 전장. 도킹 상태가 없어도 수락)
*/
table RequestUndock {
    id: string;
    method: string;
    object_type: string;
}
table ResponseUndock {
    id: string;
    result: string;
    message: string;
}


/*
    category    :       RPC
    response    :       One-shot
    topic       :       {robotType}/control/dockStop
    usage       :       도킹 정지
    field
        - method        :       "" = 진행 중인 도킹·후퇴 정지 (방식 무관), "charge" | "object" = 그 방식만
        - object_type   :       method "object" 일 때 "" = 모든 대상, "shape" = 형상 도킹만.
                                대상 도킹 취소 결과는 resultDock (method "object", result cancel)
*/
table RequestDockStop {
    id: string;
    method: string;
    object_type: string;
}
table ResponseDockStop {
    id: string;
    result: string;
    message: string;
}


