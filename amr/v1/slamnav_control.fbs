/*
    category    :       RPC
    response    :       One-shot
    topic       :       {robotType}/control/getObsBox
    usage       :       장애물 박스 범위 조회
    field
        - min           :       Obstacle Min Range Structure (x, y, z)
        - max           :       Obstacle Max Range Structure (x, y, z)
        - range         :       set Obstacle Radius
*/
table RequestGetObsBox {
    id: string;
}
table ResponseGetObsBox {
    id: string;
    min: ObsBox;
    max: ObsBox;
    range: float;
    result: string;
    message: string;
}


/*
    category    :       RPC
    response    :       One-shot
    topic       :       {robotType}/control/setObsBox
    usage       :       장애물 박스 범위 설정
    field
        - min           :       Obstacle Min Range Structure (x, y, z)
        - max           :       Obstacle Max Range Structure (x, y, z)
        - range         :       set Obstacle Radius
*/
table RequestSetObsBox {
    id: string;
    min: ObsBox;
    max: ObsBox;
    range: float;
}
table ResponseSetObsBox {
    id: string;
    min: ObsBox;
    max: ObsBox;
    range: float;
    result: string;
    message: string;
}


