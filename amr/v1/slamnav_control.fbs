    field
        - target        :       스트림 대상 ( "camera", "lidar2d", "lidar3d", "path" )
        - frequency     :       데이터 전송 주파수 (0 ~ 10 Hz)
*/
table RequestSetStreamFrequency {
    target: string;
    frequency: int;
}
table ResponseSetStreamFrequency {
