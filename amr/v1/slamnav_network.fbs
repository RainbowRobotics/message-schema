namespace SLAMNAV;


// -------------------------------------------------
// -----------                              --------
// -----------       Data Structure         --------
// -----------                              --------
// -------------------------------------------------


/*
    category    :       Data Structure
    usage       :       Wi-Fi AP 검색 정보
    field
        - in_use       :       현재 연결 중인 AP 여부
        - ssid         :       Wi-Fi SSID
        - signal       :       신호 세기
        - security     :       보안 방식
        - channel      :       무선 채널
        - rate         :       전송률
*/
table WifiInfo {
    in_use: bool;
    ssid: string;
    signal: int;
    security: string;
    channel: int;
    rate: string;
}

/*
    category    :       Data Structure
    usage       :       네트워크 인터페이스 설정 및 상태
    field
        - device       :       OS 네트워크 인터페이스 이름
        - dhcp         :       DHCP 사용 여부
        - dns          :       DNS 서버 주소 목록
        - ssid         :       Wi-Fi SSID (유선 인터페이스는 빈 문자열)
        - address      :       인터페이스 IP 주소
        - netmask      :       서브넷 마스크
        - gateway      :       기본 게이트웨이
        - signal       :       무선 신호 세기 (값이 없으면 0)
*/
table NetworkInfo {
    device: string;
    dhcp: bool;
    dns: [string];
    ssid: string;
    address: string;
    netmask: string;
    gateway: string;
    signal: int;
}

/*
    category    :       Subscribe
    topic       :       amr/{robot_model}/network/status
    usage       :       host가 주기적으로 publish하는 네트워크 상태
    field
        - ethernet     :       유선 인터페이스 목록
        - wifi         :       Wi-Fi 인터페이스 목록
        - local_ip     :       대상 서버 접속 경로에 사용되는 host 로컬 IP
        - frs_ip       :       DB에 등록된 대상 서버 IP
*/
table NetworkStatusInfo {
    ethernet: [NetworkInfo];
    wifi: [NetworkInfo];
    local_ip: string;
    frs_ip: string;
}


// -------------------------------------------------
// -----------                              --------
// -----------          RPC(Query)          --------
// -----------                              --------
// -------------------------------------------------


/*
    category    :       RPC
    response    :       One-shot
    topic       :       amr/{robot_model}/network/getInfo
    usage       :       OS adapter를 통해 현재 네트워크 인터페이스 목록 조회
    field
        - ethernet     :       유선 인터페이스 목록
        - wifi         :       Wi-Fi 인터페이스 목록
        - bluetooth    :       Bluetooth 네트워크 인터페이스 목록
        - result       :       처리 결과
        - message      :       결과 메시지
*/
table RequestNetworkGetNetwork {
}

table ResponseNetworkGetNetwork {
    ethernet: [NetworkInfo];
    wifi: [NetworkInfo];
    bluetooth: [NetworkInfo];
    result: string;
    message: string;
}

/*
    category    :       RPC
    response    :       One-shot
    topic       :       amr/{robot_model}/network/getLocalIp
    usage       :       target으로 접속할 때 OS가 선택하는 host 로컬 IP 조회
    field
        - target       :       대상 host 또는 protocol/host:port 형식의 주소
        - local_ip     :       target 방향으로 선택된 host 로컬 IP
*/
table RequestNetworkGetLocalIp {
    target: string;
}

table ResponseNetworkGetLocalIp {
    local_ip: string;
}

/*
    category    :       RPC
    response    :       One-shot
    topic       :       amr/{robot_model}/network/setInfo
    usage       :       네트워크 인터페이스 설정
    field
        - ssid         :       설정할 NetworkManager connection profile 이름
                                (Linux에서는 nmcli con modify/up 인자로 사용)
        - dhcp         :       DHCP 사용 여부
        - address      :       정적 IP 주소 (dhcp=false일 때 필수)
        - netmask      :       서브넷 마스크 (dhcp=false일 때 필수)
        - gateway      :       기본 게이트웨이 (dhcp=false일 때 필수)
        - dns          :       DNS 서버 주소 목록 (dhcp=false일 때 필수)
        - result       :       처리 결과
        - message      :       결과 메시지
*/
table RequestNetworkSetNetwork {
    ssid: string;
    dhcp: bool;
    address: string;
    netmask: string;
    gateway: string;
    dns: [string];
}

table ResponseNetworkSetNetwork {
    ssid: string;
    dhcp: bool;
    address: string;
    netmask: string;
    gateway: string;
    dns: [string];
    result: string;
    message: string;
}

/*
    category    :       RPC
    response    :       One-shot
    topic       :       amr/{robot_model}/network/connectWifi
    usage       :       Wi-Fi AP 접속
    field
        - ssid         :       접속할 Wi-Fi SSID
        - password     :       Wi-Fi 비밀번호
        - address      :       접속 후 할당된 IP 주소
        - gateway      :       접속 후 설정된 기본 게이트웨이
        - netmask      :       접속 후 설정된 서브넷 마스크
        - dns          :       접속 후 설정된 DNS 서버 주소 목록
        - signal       :       접속한 AP의 신호 세기
        - result       :       처리 결과
        - message      :       결과 메시지
*/
table RequestNetworkConnectWifi {
    ssid: string;
    password: string;
}

table ResponseNetworkConnectWifi {
    ssid: string;
    address: string;
    gateway: string;
    netmask: string;
    dns: [string];
    signal: int;
    result: string;
    message: string;
}

/*
    category    :       RPC
    response    :       One-shot
    topic       :       amr/{robot_model}/network/getWifiList
    usage       :       주변 Wi-Fi AP 목록 조회
    field
        - rescan       :       새 Wi-Fi 스캔 수행 여부
        - list         :       검색된 Wi-Fi AP 목록
        - result       :       처리 결과
        - message      :       결과 메시지
*/
table RequestNetworkGetWifiList {
    rescan: bool;
}

table ResponseNetworkGetWifiList {
    list: [WifiInfo];
    result: string;
    message: string;
}
